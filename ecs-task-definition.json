{
  "family": "orderflow-products-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::540659180627:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "products-api",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_NAME",
          "value": "OrderFlow Products Service"
        },
        {
          "name": "APP_VERSION",
          "value": "1.0.0"
        }
      ]
    }
  ]
}
